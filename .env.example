# AI Software Factory Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=aifactory
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=aifactory
DATABASE_URL=postgresql://aifactory:${POSTGRES_PASSWORD}@postgres:5432/aifactory

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Ollama AI Configuration
# ============================================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest

# ============================================
# Backend Configuration
# ============================================
ENVIRONMENT=production
LOG_LEVEL=info
SECRET_KEY=your_secret_key_here_min_32_chars
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Security & Auth Configuration
# ============================================
CORS_ORIGINS=https://ai-staging.thetalogics.com
ALLOWED_HOSTS=ai-staging.thetalogics.com
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=https://ai-staging.thetalogics.com/api
NEXT_PUBLIC_WS_URL=wss://ai-staging.thetalogics.com/ws

# ============================================
# Docker Hub Registry (Primary)
# ============================================
DOCKERHUB_USERNAME=revanth2245
DOCKERHUB_TOKEN=your_dockerhub_token
DOCKER_REGISTRY=docker.io

# ============================================
# Portainer Configuration
# ============================================
PORTAINER_URL=https://66.70.191.79:9443
PORTAINER_STACK_NAME=ai-software-factory

# ============================================
# Domain Configuration
# ============================================
DOMAIN=ai-staging.thetalogics.com
SSL_EMAIL=admin@thetalogics.com
