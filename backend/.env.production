# AI Software Factory - PRODUCTION Environment
# Copy this file to .env for production environment

# Application Settings
APP_NAME=AI Software Factory
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=WARNING

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security - Production Key (Generated securely)
# IMPORTANT: Store this in secure secrets management, NOT in version control
SECRET_KEY=fN7gLxKKVB506RppfCoenNcVFNdcEx-DlEz8EdtUg9A
ACCESS_TOKEN_EXPIRE_MINUTES=15

# CORS
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://aifactory:very_secure_password@postgres:5432/aifactory_prod
DATABASE_POOL_SIZE=20

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090