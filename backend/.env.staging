# AI Software Factory - STAGING Environment
# Copy this file to .env for staging environment

# Application Settings
APP_NAME=AI Software Factory
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=staging
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Security - Staging Key (Generated securely)
SECRET_KEY=I7ugGR3-ajW7fXyKI2yPkvX2aNDMJMZICQLdwP7tCLQ
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Host Security
ALLOWED_HOSTS=ai-staging.thetalogics.com
CORS_ORIGINS=https://ai-staging.thetalogics.com

# Database Configuration
DATABASE_URL=postgresql://aifactory:secure_password@postgres:5432/aifactory_staging
DATABASE_POOL_SIZE=10

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090