# AI Software Factory - Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
APP_NAME=AI Software Factory
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
# IMPORTANT: Use different secure keys for each environment
# Generate secure keys using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production  # MUST CHANGE IN PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS & Host Security
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# Database Configuration (Phase 5)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_factory
DATABASE_POOL_SIZE=10

# Redis Configuration (Phase 4)
REDIS_URL=redis://localhost:6379/0

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
