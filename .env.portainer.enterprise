# AI Software Factory - Enterprise Environment Variables for Portainer
# Production-ready configuration with security and monitoring
# Last Updated: 2026-03-19

# ===========================================
# SECURITY - Critical Credentials (CHANGE THESE)
# ===========================================
POSTGRES_PASSWORD=GenerateSecurePasswordHere123!
SECRET_KEY=ExtremelyLongRandomSecretKeyThatShouldBeAtLeast50CharactersLongForProductionUse
GRAFANA_ADMIN_PASSWORD=AnotherSecurePassword123!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=aifactory
POSTGRES_DB=aifactory
DATABASE_URL=postgresql://aifactory:${POSTGRES_PASSWORD}@postgres:5432/aifactory

# ===========================================
# APPLICATION ENDPOINTS
# ===========================================
DOMAIN=ai-staging.thetalogics.com
NEXT_PUBLIC_API_URL=https://${DOMAIN}/api
NEXT_PUBLIC_WS_URL=wss://${DOMAIN}/ws

# ===========================================
# CONTAINER REGISTRY
# ===========================================
DOCKERHUB_USERNAME=revanth2245
DOCKERHUB_REGISTRY=docker.io

# ===========================================
# MONITORING & ALERTING
# ===========================================
ENABLE_METRICS=true
METRICS_PORT=9090
GRAFANA_PORT=3001

# Watchtower Notifications (Email)
WATCHTOWER_EMAIL_FROM=alerts@${DOMAIN}
WATCHTOWER_EMAIL_TO=admin@thetalogics.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ===========================================
# RESOURCE MANAGEMENT
# ===========================================
ENVIRONMENT=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# AI SERVICE CONFIGURATION
# ===========================================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
LLM_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3.2

# ===========================================
# CACHING & PERFORMANCE
# ===========================================
REDIS_URL=redis://redis:6379
CACHE_TTL=3600
SESSION_TIMEOUT=1800

# ===========================================
# PORTAINER DEPLOYMENT
# ===========================================
PORTAINER_STACK_NAME=ai-software-factory-enterprise
COMPOSE_PROJECT_NAME=ai-factory-enterprise

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true

# ===========================================
# ADVANCED FEATURES
# ===========================================
ENABLE_WEBSOCKET=true
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
ENABLE_CORS=true
CORS_ORIGINS=https://${DOMAIN}
ALLOWED_HOSTS=${DOMAIN}
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# HEALTH CHECKS
# ===========================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# LOGGING
# ===========================================
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
ENABLE_AUDIT_LOGGING=true

# ===========================================
# SECURITY HEADERS
# ===========================================
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff