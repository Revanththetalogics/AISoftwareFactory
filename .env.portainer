# AI Software Factory - Environment Variables for Portainer
# These values are configured for ai-staging.thetalogics.com
# Last Updated: 2026-03-18

# ===========================================
# REQUIRED - Database Configuration
# ===========================================
POSTGRES_PASSWORD=Itslogical1.
POSTGRES_USER=aifactory
POSTGRES_DB=aifactory
DATABASE_URL=postgresql://aifactory:Itslogical1.@postgres:5432/aifactory

# ===========================================
# REQUIRED - Application Security
# ===========================================
SECRET_KEY=CF4sX0L53hAwoxcDtjvRMQuTlBVSz6JdaZYrm29N7pkWPGe8ibIOygfKHnU1qE

# ===========================================
# REQUIRED - API Configuration
# ===========================================
NEXT_PUBLIC_API_URL=https://ai-staging.thetalogics.com/api
NEXT_PUBLIC_WS_URL=wss://ai-staging.thetalogics.com/ws

# ===========================================
# REQUIRED - GitHub Container Registry
# ===========================================
GITHUB_REPOSITORY=revanththetalogics/aisoftwarefactory
GHCR_REGISTRY=ghcr.io

# ===========================================
# OPTIONAL - Infrastructure
# ===========================================
REDIS_URL=redis://redis:6379
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
ENVIRONMENT=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# OPTIONAL - Domain & SSL
# ===========================================
DOMAIN=ai-staging.thetalogics.com
SSL_EMAIL=admin@thetalogics.com

# ===========================================
# OPTIONAL - LLM Configuration
# ===========================================
LLM_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3.2

# ===========================================
# OPTIONAL - Feature Flags
# ===========================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_WEBSOCKET=true

# ===========================================
# OPTIONAL - Portainer Stack Configuration
# ===========================================
PORTAINER_STACK_NAME=ai-software-factory
COMPOSE_PROJECT_NAME=ai-factory
