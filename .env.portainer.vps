# ===========================================
# VPS RUNTIME ENVIRONMENT — ai-staging.thetalogics.com
# VPS: 66.70.191.79 | OVH Beauharnois | 12 vCores, 48GB RAM, 300GB Storage
# ===========================================
# ⚠️  This file is copied to the VPS by the deploy pipeline.
#     It is NOT committed to git (listed in .gitignore).
#     Variable interpolation (${VAR}) does NOT work here —
#     all values must be written out in full.
# ===========================================

# ===========================================
# SECURITY CREDENTIALS  ← change before going live
# ===========================================
POSTGRES_PASSWORD=Itslogical1.
# Generate a real SECRET_KEY on VPS with:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=85b08f9d8cce213d89e59112906bcaff7c1fb26edb1f2bce927b0bbbf67c77cfb6b3e704ccb0c98b5f29bc5b037850b1d6920d02a53de50417eacd2a636d1d41

# ===========================================
# DATABASE
# ===========================================
POSTGRES_USER=aifactory
POSTGRES_DB=aifactory
# ⚠️ Write the full URL — no variable interpolation in .env files
DATABASE_URL=postgresql://aifactory:Itslogical1.@postgres:5432/aifactory

# ===========================================
# APPLICATION
# ===========================================
ENVIRONMENT=staging
LOG_LEVEL=info
CORS_ORIGINS=https://ai-staging.thetalogics.com
ALLOWED_HOSTS=ai-staging.thetalogics.com
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# SERVICES  (Docker internal DNS names)
# ===========================================
REDIS_URL=redis://redis:6379
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
LLM_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=24h

# ===========================================
# CONTAINER IMAGES  (set by deploy pipeline)
# ===========================================
BACKEND_IMAGE=revanth2245/aisoftwarefactory-backend:staging
FRONTEND_IMAGE=revanth2245/aisoftwarefactory-frontend:staging
NGINX_IMAGE=revanth2245/aisoftwarefactory-nginx:staging

# ===========================================
# COMPOSE PROJECT
# ===========================================
COMPOSE_PROJECT_NAME=ai-factory