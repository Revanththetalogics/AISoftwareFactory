# Portainer-Optimized Environment Configuration
# Tailored for your VPS: 66.70.191.79 (ai-staging.thetalogics.com)

# ===========================================
# SERVER ACCESS INFORMATION
# ===========================================
# Your VPS Public IP: 66.70.191.79
# Location: Beauharnois, Canada (OVH)
# Resources: 12 vCores, 48GB RAM, 300GB Storage
# Access your application at: http://66.70.191.79

# ===========================================
# AUTO-GENERATED SECURITY CREDENTIALS
# ===========================================
POSTGRES_PASSWORD=AutoGeneratedSecurePassword123!
SECRET_KEY=ExtremelyLongRandomSecretKeyForProductionUseWith64CharactersMinimum
GRAFANA_ADMIN_PASSWORD=AnotherSecurePassword456!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_USER=aifactory
POSTGRES_DB=aifactory
DATABASE_URL=postgresql://aifactory:${POSTGRES_PASSWORD}@postgres:5432/aifactory

# ===========================================
# APPLICATION ENDPOINTS - Using Your Domain
# ===========================================
DOMAIN=ai-staging.thetalogics.com
NEXT_PUBLIC_API_URL=https://${DOMAIN}/api
NEXT_PUBLIC_WS_URL=wss://${DOMAIN}/ws

# SSL Configuration
SSL_EMAIL=admin@thetalogics.com
LETSENCRYPT_STAGING=false  # Set to true for testing

# ===========================================
# PORTAINER INTEGRATION
# ===========================================
PORTAINER_AGENT=true
PORTAINER_NETWORK=portainer-network
PORTAINER_AGENT_PORT=9001

# ===========================================
# RESOURCE OPTIMIZATION
# ===========================================
# Based on your 12 vCores and 48GB RAM:
CPU_LIMIT_BACKEND=3.0      # 25% of total cores
MEMORY_LIMIT_BACKEND=8G    # 16% of total RAM
CPU_LIMIT_OLLAMA=4.0       # 33% of total cores  
MEMORY_LIMIT_OLLAMA=16G    # 33% of total RAM
CPU_LIMIT_POSTGRES=2.0     # 17% of total cores
MEMORY_LIMIT_POSTGRES=4G   # 8% of total RAM

# ===========================================
# CONTAINER REGISTRY
# ===========================================
DOCKERHUB_USERNAME=revanth2245
DOCKERHUB_REGISTRY=docker.io

# ===========================================
# MONITORING & MAINTENANCE
# ===========================================
ENABLE_METRICS=true
METRICS_PORT=9090
WATCHTOWER_POLL_INTERVAL=3600  # Hourly updates
BACKUP_SCHEDULE="0 2 * * *"    # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ===========================================
# PERFORMANCE SETTINGS
# ===========================================
ENVIRONMENT=production
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=8000
OLLAMA_KEEP_ALIVE=24h

# ===========================================
# AI SERVICE CONFIGURATION
# ===========================================
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:latest
LLM_PROVIDER=ollama
LLM_DEFAULT_MODEL=llama3.2

# ===========================================
# CACHING & SCALABILITY
# ===========================================
REDIS_URL=redis://redis:6379
CACHE_TTL=3600
SESSION_TIMEOUT=1800
ENABLE_WEBSOCKET=true

# ===========================================
# PORTAINER DEPLOYMENT
# ===========================================
PORTAINER_STACK_NAME=ai-software-factory-vps
COMPOSE_PROJECT_NAME=ai-factory-vps
DEPLOYMENT_TYPE=portainer-stack

# ===========================================
# HEALTH CHECKS
# ===========================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ===========================================
# LOGGING & AUDITING
# ===========================================
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
ENABLE_AUDIT_LOGGING=true

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100
ENABLE_CORS=true
CORS_ORIGINS=http://${DOMAIN}:3000,http://${DOMAIN}:8000